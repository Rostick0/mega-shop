{
  "$schema": "https://www.krakend.io/schema/v2.12/krakend.json",
  "version": 3,
  "port": 80,
  "extra_config": {
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [
        {
          "encoding": "no-op",
          "url_pattern": "/api/auth/login",
          "host": ["http://auth-laravel.test-1:80"]
        }
      ]
    },
    {
      "endpoint": "/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [
        {
          "encoding": "no-op",
          "url_pattern": "/api/auth/register",
          "host": ["http://auth-laravel.test-1:80"]
        }
      ]
    },
    {
      "endpoint": "/auth/me",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [
        {
          "url_pattern": "/api/auth/me",
          "host": ["http://auth-laravel.test-1:80"]
        }
      ]
    },
    {
      "endpoint": "/carts",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/carts",
          "host": ["http://cart-laravel.test-1:80"]
        }
      ]
    },
    {
      "endpoint": "/orders",
      "method": "GET",
      "input_headers": ["Authorization", "x-user-id", "x-email"],
      "backend": [
        {
          "url_pattern": "/api/orders",
          "host": ["http://order-laravel.test-1:80"]
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "jwk_local_path": "/etc/krakend/config/settings/jwk.json",
          "disable_jwk_security": true,
          "kid": "sim1",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["email", "x-email"]
          ],
          "operation_debug": true
        }
      }
    },
    {
      "endpoint": "/orders",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/orders",
          "host": ["http://order-laravel.test-1:80"]
        }
      ]
    }
  ]
}
